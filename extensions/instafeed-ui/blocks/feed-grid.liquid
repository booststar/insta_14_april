{% comment %}
  AI Instafeed — Feed Grid Block
  Optimized for Core Web Vitals:
  - LCP < 2.5s: Emits high-priority preload for the primary feed image.
  - CLS < 0.1: Dynamically reserves exact layout dimensions via CSS variables & content-visibility.
  - Activation Lock: Automatically deactivates and hides when "Instafeed Activation" app embed is disabled.
{% endcomment %}

{% assign config_meta = app.metafields.ai_instafeed.config.value | default: shop.metafields.ai_instafeed.config.value %}
{% assign insta_meta = app.metafields.ai_instafeed.insta_data.value | default: shop.metafields.ai_instafeed.insta_data.value %}

{% comment %} Calculate dynamic layout reservation to prevent Cumulative Layout Shift (CLS) {% endcomment %}
{% assign post_feed = config_meta.postFeed %}
{% assign stories_conf = config_meta.stories %}

{% assign desk_cols = post_feed.desktopColumns | default: 4 | at_least: 1 %}
{% assign mob_cols = post_feed.mobileColumns | default: 2 | at_least: 1 %}
{% assign desk_limit = post_feed.desktopLimit | default: 8 %}
{% assign mob_limit = post_feed.mobileLimit | default: 4 %}
{% assign layout_mode = post_feed.layoutMode | default: 'grid' %}

{% assign desk_rows = 1 %}
{% assign mob_rows = 1 %}
{% if layout_mode != 'carousel' %}
  {% assign desk_rows = desk_limit | divided_by: desk_cols | at_least: 1 %}
  {% assign mob_rows = mob_limit | divided_by: mob_cols | at_least: 1 %}
{% endif %}

{% comment %} Approximate pixel height per row based on container width {% endcomment %}
{% assign desk_height = desk_rows | times: 280 %}
{% assign mob_height = mob_rows | times: 180 %}

{% if post_feed.header != false %}
  {% assign desk_height = desk_height | plus: 80 %}
  {% assign mob_height = mob_height | plus: 70 %}
{% endif %}

{% if stories_conf.enable == true %}
  {% assign desk_height = desk_height | plus: 110 %}
  {% assign mob_height = mob_height | plus: 100 %}
{% endif %}

{% comment %} Fallback reasonable defaults if no config {% endcomment %}
{% if desk_height < 300 %}
  {% assign desk_height = 650 %}
{% endif %}
{% if mob_height < 200 %}
  {% assign mob_height = 420 %}
{% endif %}

{% comment %} Preload scanner optimization for Largest Contentful Paint (LCP) {% endcomment %}
{% if insta_meta != blank and insta_meta.media != blank and insta_meta.media.data.size > 0 %}
  {% assign first_media = insta_meta.media.data[0] %}
  {% assign lcp_image_url = first_media.thumbnail_url | default: first_media.media_url %}
  {% if lcp_image_url != blank %}
    <link rel="preload" as="image" href="{{ lcp_image_url }}" fetchpriority="high">
  {% endif %}
{% endif %}

<style>
  .shopify-block.shopify-app-block,
  .shopify-app-block,
  .shopify-block,
  div[class*="shopify-app-block"],
  div[class*="shopify-block"],
  [data-block-handle="feed-grid"] {
    width: 100% !important;
    max-width: 100% !important;
  }
  instafeed-grid:not(:defined) {
    display: block;
    width: 100%;
    min-height: {{ desk_height }}px;
    background: transparent;
    content-visibility: auto;
    contain-intrinsic-size: auto {{ desk_height }}px;
  }
  @media (max-width: 768px) {
    instafeed-grid:not(:defined) {
      min-height: {{ mob_height }}px;
      contain-intrinsic-size: auto {{ mob_height }}px;
    }
  }

  /* ── Master Switch: When "Instafeed Activation" app embed is disabled, completely hide this section ── */
  html:not(:has(#ai-instafeed-active-marker)) instafeed-grid,
  html:not(:has(#ai-instafeed-active-marker)) .ai-feed-grid-section-container,
  html:not(:has(#ai-instafeed-active-marker)) [data-block-handle="feed-grid"],
  html:not(:has(#ai-instafeed-active-marker)) .shopify-block:has(instafeed-grid),
  html:not(:has(#ai-instafeed-active-marker)) .shopify-app-block:has(instafeed-grid),
  html:not(:has(#ai-instafeed-active-marker)) div[class*="shopify-block"]:has(instafeed-grid),
  html:not(:has(#ai-instafeed-active-marker)) div[class*="shopify-app-block"]:has(instafeed-grid) {
    display: none !important;
    min-height: 0 !important;
    height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
    visibility: hidden !important;
  }
</style>

{{ 'instafeed-front.css' | asset_url | stylesheet_tag: preload: true }}

{% if config_meta != blank %}
<script class="ai-instafeed-initial-data" type="application/json">
  {
    "config": {{ config_meta | json }},
    "instaData": {% if insta_meta != blank %}{{ insta_meta | json }}{% else %}null{% endif %}
  }
</script>
{% endif %}

<div class="ai-feed-grid-section-container" style="width: 100% !important;">
  <instafeed-grid css-url="{{ 'instafeed-front.css' | asset_url }}" data-logo-url="{{ 'logo.png' | asset_url }}"></instafeed-grid>
</div>
<script src="{{ 'instafeed-front.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Instafeed: Feed Grid",
  "target": "section",
  "settings": []
}
{% endschema %}
