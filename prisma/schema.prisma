// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ─────────────────────────────────────────────────────────────────────────────
// WebhookEvent – Deduplication table
// ─────────────────────────────────────────────────────────────────────────────
// Shopify can deliver the same webhook more than once. We store each unique
// `X-Shopify-Webhook-Id` so we can skip duplicate processing.
// Rows can be pruned after 7 days; they are written ONCE per delivery.
model WebhookEvent {
  id          String   @id @default(cuid())
  webhookId   String   @unique         // X-Shopify-Webhook-Id header value
  topic       String                   // e.g. "products/create"
  shop        String                   // e.g. "mystore.myshopify.com"
  processedAt DateTime @default(now())

  @@index([shop])
  @@index([processedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// FeedMetric – Daily Storefront Analytics Aggregation
// ─────────────────────────────────────────────────────────────────────────────
model FeedMetric {
  id        String   @id @default(cuid())
  shop      String
  date      String   // Format: YYYY-MM-DD
  views     Int      @default(0)
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, date])
  @@index([shop])
  @@index([date])
}

// ─────────────────────────────────────────────────────────────────────────────
// EmailLog – Real-time tracking of all sent/failed merchant emails
// ─────────────────────────────────────────────────────────────────────────────
model EmailLog {
  id             String    @id @default(cuid())
  shop           String
  emailType      String    // "welcome", "reinstall", "uninstall", "setup_reminder", "monthly_report", "support"
  recipient      String
  subject        String
  status         String    // "SENT", "FAILED", "SKIPPED"
  messageId      String?
  error          String?
  openCount      Int       @default(0)
  openedAt       DateTime?
  clickCount     Int       @default(0)
  clickedAt      DateTime?
  lastClickedUrl String?
  createdAt      DateTime  @default(now())

  @@index([shop])
  @@index([emailType])
  @@index([status])
  @@index([createdAt])
}

